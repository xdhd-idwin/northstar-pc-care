{
  "name": "northstar-pc-care",
  "version": "0.1.1",
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "description": "Windows system care desktop app starter",
  "author": "Northstar PC Care",
  "repository": "https://github.com/xdhd-idwin/northstar-pc-care",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.61.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.northstar.pccare",
    "productName": "Northstar PC Care",
    "forceCodeSigning": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "electron/powershell/SystemOps.ps1",
        "to": "powershell/SystemOps.ps1"
      },
      {
        "from": "electron/update-source.json",
        "to": "update-source.json"
      }
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xdhd-idwin",
        "repo": "northstar-pc-care"
      }
    ]
  }
}

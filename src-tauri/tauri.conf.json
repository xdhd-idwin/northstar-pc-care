{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Northstar PC Care",
  "version": "0.1.3",
  "identifier": "com.northstar.pccare",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm run dev:web",
    "beforeBuildCommand": "pnpm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "Northstar PC Care",
        "width": 1320,
        "height": 860,
        "minWidth": 1050,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https://northstar-billing.northstar-billing-service.workers.dev"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../electron/powershell/SystemOps.ps1": "powershell/SystemOps.ps1",
      "../electron/billing-source.json": "billing-source.json"
    },
    "windows": {"nsis": {"installMode": "perMachine", "displayLanguageSelector": false}}
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwOTAzNDY0QUI2RTI4NzQKUldSMEtHNnJaRFNRSUFybkgzUlhqQ1Z2WDZZU0pEVXo0ODBwTVlRc3MxZlVSS1RoY1FrTFJZS2EK",
      "endpoints": ["https://github.com/xdhd-idwin/northstar-pc-care/releases/latest/download/latest.json"]
    }
  }
}
